{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ebooking_events;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "ebooking-events"
  },
  "Jwt": {
    "Secret": "ETO-MY-SECRET-KEY-FOR-EBOOKING-PROJECT-PRACTICUM-HELLO-I-NEED-MORE-THEN-32-CHARS",
    "Issuer": "EBooking",
    "Audience": "EBookingClient"
  },
  "OpenTelemetry": {
    "ServiceName": "events-api"
  },

  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Cache": {
    "EventTtlMinutes": 10,
    "TopEventsTtlMinutes": 5
  },

  "AllowedHosts": "*"
}